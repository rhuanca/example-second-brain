# Secrets / local config
.env

# Obsidian vault (data, not code) — keep out of the repo.
# This repo is public: a stray `git add -A` here would publish every note and
# every full-text archive. Match vault directories by name, not one fixed path.
/vault/
Renan_Vault/
*Vault*/
*.source.md

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Knowledge-base embedding index + downloaded model, when KB_INDEX_DIR points
# inside the project (derived data, rebuildable, and it indexes your notes).
/.kb-index/

# Generated diagram renders (keep the .mmd sources)
.diagrams/*.svg
.diagrams/*.png
.diagrams/*.json

# OS
.DS_Store
