# Secrets / local config
.env

# Obsidian vault (data, not code) — keep out of the repo.
# This repo is public: a stray `git add -A` here would publish every note and
# every full-text archive. Match vault directories by name, not one fixed path.
/vault/
Renan_Vault/
*Vault*/
*.source.md

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Knowledge-base embedding index + downloaded model, when KB_INDEX_DIR points
# inside the project (derived data, rebuildable, and it indexes your notes).
/.kb-index/
# Stars/archive/reads state when KB_STATE_DB points inside the project (+ WAL files).
/.kb-state.db*

# Generated diagram renders (keep the .mmd sources)
.diagrams/*.svg
.diagrams/*.png
.diagrams/*.json

# Editor leftovers. These matter as much as the secret files themselves: an
# editor drops a swap/backup file beside the file it is editing, holding the
# same contents under a name the secret's own rule does not match — which is how
# a `git add -A` can commit credentials that looked ignored.
*.swp
*.swo
*~

# OS
.DS_Store

# Personal runbooks with real hostnames/ids (not for a public repo)
*.local.md
